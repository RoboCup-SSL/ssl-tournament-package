[Unit]
Description=SSL Tournament Package
Documentation=https://github.com/RoboCup-SSL/ssl-tournament-package
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ssl-tournament
Group=ssl-tournament
# --host 0.0.0.0 so refs/helpers on the venue Wi-Fi reach it from their phones.
# install.sh rewrites the port if PORT is set.
ExecStart=/usr/local/bin/ssl-tournament --host 0.0.0.0 --port 8080
Restart=always
RestartSec=2

# StateDirectory creates & owns /var/lib/ssl-tournament (the tournament DB lives
# here from Milestone 1 on); it survives uninstall so data isn't lost.
StateDirectory=ssl-tournament
Environment=SSL_TOURNAMENT_DATA_DIR=/var/lib/ssl-tournament

# Hardening — the service only needs to serve HTTP and write its data dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ssl-tournament

[Install]
WantedBy=multi-user.target
